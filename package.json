{
  "name": "@omnidotdev/runa-api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "build/server.js",
  "module": "build/server.js",
  "type": "module",
  "scripts": {
    "release": "changeset publish",
    "dev": "NODE_ENV=development GRAPHILE_ENV=development bun run --watch src/server.ts",
    "build": "bun build --target node --outdir build src/server.ts src/instrumentation.ts",
    "start": "NODE_ENV=production GRAPHILE_ENV=production bun run src/scripts/db/migrate.ts && NODE_ENV=production GRAPHILE_ENV=production bun run --import ./build/instrumentation.js build/server.js",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "knip": "knip-bun",
    "test": "bun test --isolate",
    "db:setup": "bun src/scripts/db/setupDatabase.ts",
    "db:check": "bun --env-file .env.local drizzle-kit check --config src/lib/config/drizzle.config.ts",
    "db:generate": "bun --env-file .env.local drizzle-kit generate --config src/lib/config/drizzle.config.ts",
    "db:migrate": "bun --env-file .env.local drizzle-kit migrate --config src/lib/config/drizzle.config.ts && GRAPHILE_ENV=development bun graphql:generate",
    "db:migrate:drop": "bun --env-file .env.local drizzle-kit drop --config src/lib/config/drizzle.config.ts",
    "db:pull": "bun --env-file .env.local drizzle-kit introspect --config src/lib/config/drizzle.config.ts",
    "db:push": "bun --env-file .env.local drizzle-kit push --config src/lib/config/drizzle.config.ts",
    "db:seed": "NODE_ENV=development bun run --env-file .env.local src/scripts/db/seedDatabase.ts",
    "db:studio": "bun --env-file .env.local drizzle-kit studio --config src/lib/config/drizzle.config.ts",
    "db:up": "bun --env-file .env.local drizzle-kit up --config src/lib/config/drizzle.config.ts",
    "db:normalize-due-dates": "bun run --env-file .env.local src/scripts/normalizeDueDates.ts",
    "authz:backfill": "bun run --env-file .env.local src/scripts/authz/backfillProjectTuples.ts",
    "authz:detect-drift": "bun run --env-file .env.local src/scripts/authz/detectDrift.ts",
    "authz:reconcile": "bun run --env-file .env.local src/scripts/authz/reconcile.ts",
    "search:reconcile": "bun run --env-file .env.local src/scripts/search/reconcile.ts",
    "graphql:generate": "GRAPHILE_ENV=development bun run --env-file .env.local src/scripts/generateGraphqlSchema.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/graphql-yoga": "^1.4.0",
    "@envelop/generic-auth": "^11.0.0",
    "@envelop/opentelemetry": "^9.0.0",
    "@envelop/parser-cache": "^10.0.0",
    "@envelop/validation-cache": "^10.0.0",
    "@graphile/pg-aggregates": "^0.2.0-rc.1",
    "@graphile/simplify-inflection": "^9.0.1",
    "@graphql-yoga/plugin-disable-introspection": "^2.19.0",
    "@omnidotdev/cadence": "github:omnidotdev/cadence#v0.1.0",
    "@omnidotdev/providers": "github:omnidotdev/providers#5dc315939682ad5a01666c0e6df9336fa202982a",
    "@omnidotdev/search": "github:omnidotdev/search",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@smithy/node-http-handler": "^4.8.1",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.21",
    "elysia-rate-limit": "^4.5.0",
    "fractional-indexing": "^4.0.0",
    "grafast": "^1.2.0",
    "graphile-export": "^1.0.2",
    "graphql": "^16.12.0",
    "graphql-yoga": "^5.18.0",
    "pg": "^8.16.3",
    "postgraphile": "^5.2.1",
    "postgraphile-plugin-connection-filter": "^4.0.1",
    "sharp": "^0.35.1",
    "unleash-client": "^6.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.3.5",
    "drizzle-kit": "^0.31.8",
    "drizzle-seed": "^0.3.1",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "replace-in-file": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
